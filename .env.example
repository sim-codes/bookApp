# Copy to .env and adjust. Expo reads EXPO_PUBLIC_ variables at bundle time, so restart `expo start` after changing.
# Leave EXPO_PUBLIC_API_BASE_URL unset to run without a server (everything stays on the device).

# Android emulator or USB device: run `adb reverse tcp:5155 tcp:5155` and `adb reverse tcp:8333 tcp:8333`, then use localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5155
